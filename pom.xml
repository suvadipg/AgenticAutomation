<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.google.adk</groupId>
    <artifactId>google-adk-samples</artifactId>
    <version>1.3.1-SNAPSHOT</version><!-- {x-version-update:google-adk:current} -->
    <relativePath>..</relativePath>
  </parent>

  <groupId>com.google.adk.samples</groupId>
  <artifactId>agentic-automation-parent</artifactId>
  <packaging>pom</packaging>

  <name>Google ADK - Sample - Agentic Automation</name>
  <description>
    A low-code workflow automation engine (inspired by activepieces) built on the Google ADK,
    where each flow step is either a deterministic "piece" action or an AI-agent step backed by
    LlmAgent. This module is intentionally not a minimal single-file sample: it is the first
    milestone of a multi-module, incubating project (see README.md).
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <java.version>17</java.version>
    <google-adk.version>${project.version}</google-adk.version>
    <commons-jexl3.version>3.4.0</commons-jexl3.version>
    <!-- Matches contrib/spring-ai/pom.xml's pinned version for this BOM. -->
    <testcontainers.version>1.21.3</testcontainers.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <modules>
    <module>pieces-sdk</module>
    <module>pieces-standard</module>
    <module>engine</module>
    <module>persistence</module>
    <module>backend</module>
  </modules>
</project>
