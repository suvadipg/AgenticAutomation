<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.google.adk.samples</groupId>
    <artifactId>agentic-automation-parent</artifactId>
    <version>1.3.1-SNAPSHOT</version><!-- {x-version-update:google-adk:current} -->
    <relativePath>..</relativePath>
  </parent>

  <artifactId>agentic-automation-engine</artifactId>
  <packaging>jar</packaging>

  <name>Google ADK - Sample - Agentic Automation - Engine</name>
  <description>
    The flow domain model and executor: walks a chain of PIECE / AI_AGENT / ROUTER /
    LOOP_ON_ITEMS steps, resolving {{...}} expressions between them. AI_AGENT steps are backed
    by a real ADK LlmAgent + Runner; PIECE steps can be handed to an AI_AGENT step as a genuine
    ADK tool via PieceActionTool.
  </description>

  <properties>
    <!-- Main class for exec-maven-plugin -->
    <exec.mainClass>com.google.adk.automation.engine.cli.RunSampleFlowCli</exec.mainClass>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.google.adk.samples</groupId>
      <artifactId>agentic-automation-pieces-sdk</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.google.adk</groupId>
      <artifactId>google-adk</artifactId>
      <version>${google-adk.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-jexl3</artifactId>
      <version>${commons-jexl3.version}</version>
    </dependency>

    <dependency>
      <groupId>com.google.adk.samples</groupId>
      <artifactId>agentic-automation-pieces-standard</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.google.truth</groupId>
      <artifactId>truth</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <source>${java.version}</source>
          <target>${java.version}</target>
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <mainClass>${exec.mainClass}</mainClass>
          <classpathScope>runtime</classpathScope>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
