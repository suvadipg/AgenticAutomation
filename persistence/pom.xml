<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.google.adk.samples</groupId>
    <artifactId>agentic-automation-parent</artifactId>
    <version>1.3.1-SNAPSHOT</version><!-- {x-version-update:google-adk:current} -->
    <relativePath>..</relativePath>
  </parent>

  <artifactId>agentic-automation-persistence</artifactId>
  <packaging>jar</packaging>

  <name>Google ADK - Sample - Agentic Automation - Persistence</name>
  <description>
    Postgres-backed flow storage: JPA entities + Flyway migrations for flows, flow_versions
    (DRAFT/LOCKED), flow_runs, step_results, connections, and webhook_registrations, plus
    FlowVersionService (draft upsert / publish / lock) and FlowRunService (executes the engine's
    FlowExecutor and persists each StepResult incrementally via FlowRunListener). Framework-
    agnostic (plain JPA/Hibernate, no Spring dependency) so it can be used standalone or wrapped
    by a Spring Boot backend later (M3).
  </description>

  <dependencies>
    <dependency>
      <groupId>com.google.adk.samples</groupId>
      <artifactId>agentic-automation-engine</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.google.adk.samples</groupId>
      <artifactId>agentic-automation-pieces-sdk</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Versions for all of the below are managed by the spring-boot-dependencies BOM imported
         in the root parent pom's <dependencyManagement>; none of this module's own code depends
         on Spring itself. -->
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>com.google.adk.samples</groupId>
      <artifactId>agentic-automation-pieces-standard</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.google.truth</groupId>
      <artifactId>truth</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <source>${java.version}</source>
          <target>${java.version}</target>
          <parameters>true</parameters>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
