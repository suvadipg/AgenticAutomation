<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

  <!-- No <jta-data-source>/<jdbc.url> here: connection details are supplied at runtime via
       Persistence.createEntityManagerFactory("agentic-automation", overrides) in
       PersistenceUnitProvider, so the same unit works against a local Postgres, Testcontainers,
       or a future production database without editing this file. Schema is owned by Flyway
       (V1__init.sql) — hbm2ddl.auto is intentionally "none". -->
  <persistence-unit name="agentic-automation" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

    <class>com.google.adk.automation.persistence.entity.FlowEntity</class>
    <class>com.google.adk.automation.persistence.entity.FlowVersionEntity</class>
    <class>com.google.adk.automation.persistence.entity.FlowRunEntity</class>
    <class>com.google.adk.automation.persistence.entity.StepResultEntity</class>
    <class>com.google.adk.automation.persistence.entity.ConnectionEntity</class>
    <class>com.google.adk.automation.persistence.entity.WebhookRegistrationEntity</class>

    <exclude-unlisted-classes>true</exclude-unlisted-classes>

    <properties>
      <property name="hibernate.hbm2ddl.auto" value="none"/>
      <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
    </properties>
  </persistence-unit>
</persistence>
